# Environment configuration for EMS Docker deployment
# Copy this file to .env and modify as needed

# Database Configuration
DB_HOST=mysql-ems
DB_PORT=3306
DB_NAME=ems_database
DB_USER=ems_user
DB_PASSWORD=ems_password
MYSQL_ROOT_PASSWORD=root123

# Application Configuration
APP_PORT=8080
APP_CONTEXT=ems

# JVM Configuration
CATALINA_OPTS="-Xmx1536m -Xms512m -server -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:G1HeapRegionSize=16m -XX:+UseStringDeduplication -XX:+OptimizeStringConcat -XX:+UseCompressedOops -XX:+DisableExplicitGC"
JAVA_OPTS="-Djava.awt.headless=true -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8 -Djava.net.preferIPv4Stack=true"

# Development vs Production
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
